<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The launchd agent that runs feral-engine. scripts/install-engine.sh fills in @ENGINE@ and @LOGS@
  and installs it as ~/Library/LaunchAgents/local.feral.engine.plist.

  KeepAlive restarts the engine when it crashes or exits with an error, ThrottleInterval keeps the
  restart to about a second, and a clean stop (SIGTERM, exit status 0) is left stopped.
  ProcessType Interactive keeps macOS from treating it as a throttled background job.
-->
<plist version="1.0">
<dict>
    <key>Label</key><string>local.feral.engine</string>
    <key>ProgramArguments</key>
    <array>
        <string>@ENGINE@</string>
        <string>run</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key><false/>
        <key>Crashed</key><true/>
    </dict>
    <key>ThrottleInterval</key><integer>1</integer>
    <key>ProcessType</key><string>Interactive</string>
    <key>LimitLoadToSessionType</key><string>Aqua</string>
    <key>StandardOutPath</key><string>@LOGS@/feral-engine.log</string>
    <key>StandardErrorPath</key><string>@LOGS@/feral-engine.log</string>
</dict>
</plist>
